# Optional: OpenAI-compatible API key for the LangChain agent.
# Works with OpenAI, Groq, or any OpenAI-compatible provider.
# If not set, the /agent endpoint falls back to rule-based routing.
OPENAI_API_KEY=sk-...

# Required only for non-OpenAI providers (e.g. Groq, local LLM).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Required only if using Groq or a local model instead of OpenAI.
# LLM_MODEL=llama3-8b-8192
